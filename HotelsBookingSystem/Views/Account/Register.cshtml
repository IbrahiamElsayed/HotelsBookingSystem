@model HotelsBookingSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-container { min-height: calc(100vh - 80px); display: flex; align-items: center; }
    .auth-card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.12); }
    .auth-left {
        background: linear-gradient(135deg, #0f4c81 0%, #0a3560 100%);
        min-height: 100%; display: flex; flex-direction: column; justify-content: center;
        padding: 50px; position: relative; overflow: hidden;
    }
    .auth-left::before {
        content: ''; position: absolute; top: -50%; left: -50%;
        width: 200%; height: 200%;
        background: radial-gradient(circle, rgba(212,168,67,0.1) 0%, transparent 70%);
    }
    .auth-right { padding: 40px 50px; }
    .form-floating .form-control { border-radius: 10px; border: 2px solid #e9ecef; transition: all 0.3s ease; }
    .form-floating .form-control:focus { border-color: #0f4c81; box-shadow: 0 0 0 0.2rem rgba(15,76,129,0.15); }
    .btn-register {
        background: linear-gradient(135deg, #d4a843, #c9952e); border: none;
        border-radius: 10px; padding: 12px; font-weight: 600; transition: all 0.3s ease;
    }
    .btn-register:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(212,168,67,0.4); }
    .input-group .form-control { border-right: none; border-radius: 10px 0 0 10px; }
    .input-group-text { background: transparent; border: 2px solid #e9ecef; border-left: none; border-radius: 0 10px 10px 0; cursor: pointer; }
</style>

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="auth-card row g-0">
                    <!-- Left Side -->
                    <div class="col-lg-4 auth-left d-none d-lg-flex">
                        <div class="position-relative" style="z-index:1;">
                            <h2 class="text-white fw-bold mb-3"><i class="bi bi-building me-2"></i>Hotelier</h2>
                            <h4 class="text-white fw-light mb-4">Join Our Community</h4>
                            <p class="text-white-50 mb-4" style="line-height:1.8;">
                                Create an account to start booking your dream stays and enjoy exclusive member benefits.
                            </p>
                            <div class="border-top border-secondary pt-4 mt-4">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                                    <span class="text-white-50">Exclusive member discounts</span>
                                </div>
                                <div class="d-flex align-items-center mb-3">
                                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                                    <span class="text-white-50">Easy booking management</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                                    <span class="text-white-50">24/7 customer support</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side - Register Form -->
                    <div class="col-lg-8 auth-right">
                        <div class="text-center mb-4">
                            <h3 class="fw-bold" style="color: #0f4c81;">
                                <i class="bi bi-person-plus me-2"></i>Create Account
                            </h3>
                            <p class="text-muted">Fill in your details to get started</p>
                        </div>

                        @if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
                        {
                            <div class="alert alert-danger rounded-3" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(x => x.Errors))
                                {
                                    <span>@error.ErrorMessage</span>
                                }
                            </div>
                        }

                        <form asp-action="Register" class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                                    <label><i class="bi bi-person me-1"></i>Full Name</label>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="UserName" class="form-control" placeholder="Username" />
                                    <label><i class="bi bi-at me-1"></i>Username</label>
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control" placeholder="Email" />
                                    <label><i class="bi bi-envelope me-1"></i>Email</label>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Country" class="form-control" placeholder="Country" />
                                    <label><i class="bi bi-globe me-1"></i>Country</label>
                                    <span asp-validation-for="Country" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="City" class="form-control" placeholder="City" />
                                    <label><i class="bi bi-geo-alt me-1"></i>City</label>
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="NationalId" class="form-control" placeholder="National ID" />
                                    <label><i class="bi bi-credit-card me-1"></i>National ID</label>
                                    <span asp-validation-for="NationalId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" type="password" class="form-control" id="Password" placeholder="Password" />
                                    <label><i class="bi bi-lock me-1"></i>Password</label>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword" placeholder="Confirm Password" />
                                    <label><i class="bi bi-lock-fill me-1"></i>Confirm Password</label>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-register text-white w-100 py-3">
                                    <i class="bi bi-person-plus me-2"></i>Create Account
                                </button>
                            </div>
                            <div class="col-12 text-center">
                                <span class="text-muted">Already have an account? </span>
                                <a asp-action="Login" class="fw-bold text-decoration-none" style="color:#0f4c81;">Sign In</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
