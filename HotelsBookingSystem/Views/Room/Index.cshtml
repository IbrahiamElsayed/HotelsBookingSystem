
@using X.PagedList
@using X.PagedList.Mvc.Core
@using HotelsBookingSystem.ViewModels
@model IPagedList<RoomViewModel>
@{
    ViewData["Title"] = "Our Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .page-header {
            background: linear-gradient(135deg, #0f4c81 0%, #0a3560 100%);
            padding: 60px 0 30px;
            margin-top: -20px;
        }
        .filter-card {
            background: #fff;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            margin-top: -30px;
            position: relative;
            z-index: 10;
        }
        .filter-card .form-control, .filter-card .form-select {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 10px 15px;
        }
        .filter-card .form-control:focus, .filter-card .form-select:focus {
            border-color: #0f4c81;
        }
        .room-card { border: none; border-radius: 16px; overflow: hidden; transition: all 0.4s ease; background: #fff; }
        .room-card:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(0,0,0,0.12); }
        .room-card img { transition: transform 0.5s ease; }
        .room-card:hover img { transform: scale(1.08); }
        .price-badge { background: linear-gradient(135deg, #0f4c81, #0a3560); color: #fff; padding: 6px 16px; border-radius: 20px; font-weight: 600; font-size: 0.9rem; }
        .pagination .page-item .page-link { border-radius: 8px; margin: 0 3px; color: #0f4c81; border: 2px solid #e9ecef; }
        .pagination .page-item.active .page-link { background: #0f4c81; border-color: #0f4c81; }
        #map { border-radius: 16px; overflow: hidden; }
    </style>
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-white">Rooms</li>
            </ol>
        </nav>
        <h1 class="text-white fw-bold">Our Rooms</h1>
        <p class="text-white-50">Find the perfect room for your stay</p>
    </div>
</div>

<!-- Filter Section -->
<div class="container">
    <div class="filter-card">
        <form method="post" asp-action="filter" asp-controller="Room" novalidate="novalidate">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">Room Type</label>
                    <select name="TypeFilter" class="form-select">
                        <option value="">All Types</option>
                        <option value="All" selected="@(Model.FirstOrDefault()?.TypeFilter == "All")">All</option>
                        @foreach (var type in Model.FirstOrDefault()?.typslist ?? new List<string>())
                        {
                            <option value="@type" selected="@(type == Model.FirstOrDefault()?.TypeFilter)">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">Min Price</label>
                    <input type="number" name="MinPrice" class="form-control" placeholder="$0" value="@Model.FirstOrDefault()?.MinPrice" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">Max Price</label>
                    <input type="number" name="MaxPrice" class="form-control" placeholder="$1000" value="@Model.FirstOrDefault()?.MaxPrice" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">Hotel</label>
                    <select name="HotelId" class="form-select">
                        <option value="">All Hotels</option>
                        <option value="0" selected="@(Model.FirstOrDefault()?.HotelId == 0)">All</option>
                        @foreach (var hotel in Model.FirstOrDefault()?.hotels ?? new List<Hotel>())
                        {
                            <option value="@hotel.Id" selected="@(hotel.Id == Model.FirstOrDefault()?.HotelId)">@hotel.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">City</label>
                    <select name="City" class="form-select">
                        <option value="">All Cities</option>
                        <option value="All" selected="@(Model.FirstOrDefault()?.City == "All")">All</option>
                        @foreach (var city in Model.FirstOrDefault()?.hotels.Select(h => h.City).Distinct() ?? new List<string>())
                        {
                            <option value="@city" selected="@(city == Model.FirstOrDefault()?.City)">@city</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
                <div class="col-md-1">
                    <a href="/Room/Index" class="btn btn-outline-secondary w-100 rounded-pill py-2">Clear</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Message -->
@if (!string.IsNullOrEmpty(ViewBag.Message as string))
{
    <div class="container mt-4">
        <div class="alert alert-warning rounded-3 d-flex align-items-center">
            <i class="bi bi-info-circle me-2 fs-5"></i>
            <strong>@ViewBag.Message</strong>
            @ViewBag.FilterError
        </div>
    </div>
}

<!-- Room Listing -->
<section class="py-5">
    <div class="container">
        @if (Model == null || !Model.Any() || Model.All(r => r.Id == 0))
        {
            <div class="text-center py-5">
                <i class="bi bi-house-door display-1 text-muted"></i>
                <h4 class="text-muted mt-3">No rooms found matching your criteria</h4>
                <a href="/Room/Index" class="btn btn-primary rounded-pill px-4 mt-3">View All Rooms</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var i in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="room-card shadow-sm h-100">
                            <div class="position-relative overflow-hidden">
                                @if (i.RoomImages != null && i.RoomImages.Any())
                                {
                                    <img src="@i.RoomImages.FirstOrDefault()" class="card-img-top" style="height:220px; object-fit:cover;" alt="Room">
                                }
                                else
                                {
                                    <img src="/images/default-room.jpg" class="card-img-top" style="height:220px; object-fit:cover;" alt="Room">
                                }
                                <span class="position-absolute top-0 end-0 price-badge m-3">$@i.PricePerNight<small>/night</small></span>
                            </div>
                            <div class="p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0">@i.Type</h5>
                                </div>
                                <p class="text-muted small mb-2"><i class="bi bi-building me-1"></i>@i.hotel?.Name</p>
                                <div class="d-flex gap-3 mb-3 text-muted small">
                                    <span><i class="bi bi-bed me-1"></i>@i.NumberOfBeds Beds</span>
                                    <span><i class="bi bi-wifi me-1"></i>WiFi</span>
                                    <span><i class="bi bi-door-open me-1"></i>#@i.RoomNumber</span>
                                </div>
                                <p class="text-muted small mb-3" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@i.Description</p>
                                <div class="d-flex gap-2">
                                    <a href="/Room/Detail/@i.Id" class="btn btn-primary btn-sm rounded-pill px-3 flex-grow-1">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a href="@Url.Action("AddToCart", "Cart", new { roomId = i.Id, checkIn = DateTime.Now, checkOut = DateTime.Now.AddDays(1) })" class="btn btn-dark btn-sm rounded-pill px-3">
                                        <i class="bi bi-cart-plus"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- Map -->
<div class="container mb-5">
    <h4 class="fw-bold mb-3" style="color:#0f4c81;"><i class="bi bi-geo-alt me-2"></i>Room Locations</h4>
    <div id="map" style="height: 350px; border-radius: 16px; overflow:hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.08);"></div>
</div>

<!-- Pagination -->
@{
    string actionName = (ViewBag.IsFiltered == true) ? "filter" : "Index";
}
<div class="container pb-5">
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="@actionName" asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-type="@Model.FirstOrDefault()?.TypeFilter"
                       asp-route-minPrice="@Model.FirstOrDefault()?.MinPrice"
                       asp-route-maxPrice="@Model.FirstOrDefault()?.MaxPrice"
                       asp-route-hotelId="@Model.FirstOrDefault()?.HotelId"
                       asp-route-city="@Model.FirstOrDefault()?.City">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
            }

            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="@actionName" asp-route-page="@i"
                       asp-route-type="@Model.FirstOrDefault()?.TypeFilter"
                       asp-route-minPrice="@Model.FirstOrDefault()?.MinPrice"
                       asp-route-maxPrice="@Model.FirstOrDefault()?.MaxPrice"
                       asp-route-hotelId="@Model.FirstOrDefault()?.HotelId"
                       asp-route-city="@Model.FirstOrDefault()?.City">
                        @i
                    </a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="@actionName" asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-type="@Model.FirstOrDefault()?.TypeFilter"
                       asp-route-minPrice="@Model.FirstOrDefault()?.MinPrice"
                       asp-route-maxPrice="@Model.FirstOrDefault()?.MaxPrice"
                       asp-route-hotelId="@Model.FirstOrDefault()?.HotelId"
                       asp-route-city="@Model.FirstOrDefault()?.City">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
            }
        </ul>
    </nav>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map', { minZoom: 4, maxZoom: 15 }).setView([30.0444, 31.2357], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '' }).addTo(map);
        var bounds = [];
        @foreach (var h in Model)
        {
            if (h.hotel != null && !string.IsNullOrEmpty(h.hotel.Latitude) && !string.IsNullOrEmpty(h.hotel.Longitude))
            {
                <text>
                    var lat = parseFloat('@h.hotel.Latitude'.replace(',', '.'));
                    var lng = parseFloat('@h.hotel.Longitude'.replace(',', '.'));
                    if (!isNaN(lat) && !isNaN(lng)) {
                        var marker = L.marker([lat, lng]).addTo(map).bindPopup('<b>@h.hotel.Name</b><br>@h.hotel.Phone');
                        bounds.push([lat, lng]);
                    }
                </text>
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
