@using System.Linq
@{
    ViewData["Title"] = "Welcome to Hotelier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hero-carousel .carousel-item {
        height: 92vh;
        min-height: 600px;
    }
    .hero-carousel .carousel-item img {
        object-fit: cover;
        height: 100%;
    }
    .hero-overlay {
        background: linear-gradient(135deg, rgba(10,22,40,0.85) 0%, rgba(15,76,129,0.7) 100%);
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
    }
    .booking-card {
        background: rgba(255,255,255,0.97);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.12);
        margin-top: -60px;
        position: relative;
        z-index: 10;
    }
    .room-card, .hotel-card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.4s ease;
        background: #fff;
    }
    .room-card:hover, .hotel-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    }
    .room-card img, .hotel-card img {
        transition: transform 0.5s ease;
    }
    .room-card:hover img, .hotel-card:hover img {
        transform: scale(1.08);
    }
    .price-badge {
        background: linear-gradient(135deg, #0f4c81, #0a3560);
        color: #fff;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }
    .star-rating { color: #d4a843; }
    .stats-box {
        background: #fff;
        border-radius: 12px;
        padding: 25px 20px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
    }
    .stats-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .stats-box i { color: #0f4c81; }
    .testimonial-card {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .btn-gold {
        background: linear-gradient(135deg, #d4a843, #c9952e);
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-gold:hover {
        background: linear-gradient(135deg, #e0b95c, #d4a843);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(212,168,67,0.4);
    }
</style>

<!-- Hero Carousel -->
<div class="container-fluid p-0 hero-carousel">
    <div id="header-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="/images/carousel-1.jpg" alt="Luxury Hotel">
                <div class="hero-overlay d-flex align-items-center">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <h6 class="text-white-50 text-uppercase mb-3 fw-bold" style="letter-spacing:3px;">Welcome to Hotelier</h6>
                                <h1 class="display-3 text-white fw-bold mb-4" style="line-height:1.2;">Experience Luxury <br>& Comfort</h1>
                                <p class="text-white-50 mb-4 fs-5" style="max-width:500px;">Discover the finest hotels and resorts. Book your perfect stay with just a few clicks.</p>
                                <div class="d-flex gap-3">
                                    <a href="@Url.Action("Index", "Room")" class="btn btn-gold btn-lg px-5 py-3 rounded-pill">
                                        <i class="bi bi-door-open me-2"></i>Explore Rooms
                                    </a>
                                    <a href="#booking" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill">
                                        <i class="bi bi-calendar-check me-2"></i>Book Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="/images/carousel-2.jpg" alt="Premium Suite">
                <div class="hero-overlay d-flex align-items-center">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <h6 class="text-white-50 text-uppercase mb-3 fw-bold" style="letter-spacing:3px;">Premium Collection</h6>
                                <h1 class="display-3 text-white fw-bold mb-4" style="line-height:1.2;">Unforgettable <br>Experiences Await</h1>
                                <p class="text-white-50 mb-4 fs-5" style="max-width:500px;">From stunning views to world-class amenities, every detail is crafted for your comfort.</p>
                                <div class="d-flex gap-3">
                                    <a href="@Url.Action("Index", "Hotel")" class="btn btn-gold btn-lg px-5 py-3 rounded-pill">
                                        <i class="bi bi-building me-2"></i>Browse Hotels
                                    </a>
                                    <a href="@Url.Action("Index", "About")" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill">
                                        <i class="bi bi-play-circle me-2"></i>Learn More
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

<!-- Booking Form -->
<div id="booking" class="container" style="margin-top: -50px; position: relative; z-index: 10;">
    <form method="get" asp-action="AvailableRooms" asp-controller="Room">
        <div class="booking-card p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted"><i class="bi bi-calendar-event me-1"></i>Check In</label>
                    <input type="date" name="checkIn" class="form-control form-control-lg border-0 bg-light" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted"><i class="bi bi-calendar-check me-1"></i>Check Out</label>
                    <input type="date" name="checkOut" class="form-control form-control-lg border-0 bg-light" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted"><i class="bi bi-people me-1"></i>Adults</label>
                    <select name="adults" class="form-select form-select-lg border-0 bg-light" required>
                        <option value="1">1 Adult</option>
                        <option value="2">2 Adults</option>
                        <option value="3">3 Adults</option>
                        <option value="4">4 Adults</option>
                        <option value="5">5 Adults</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted"><i class="bi bi-person me-1"></i>Children</label>
                    <select name="children" class="form-select form-select-lg border-0 bg-light" required>
                        <option value="0">No Children</option>
                        <option value="1">1 Child</option>
                        <option value="2">2 Children</option>
                        <option value="3">3 Children</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold">
                        <i class="bi bi-search me-2"></i>Search Available Rooms
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Stats -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="stats-box">
                    <i class="fa fa-hotel fa-2x mb-3"></i>
                    <h2 class="fw-bold mb-1">@ViewBag.TotalRooms</h2>
                    <p class="text-muted mb-0">Luxury Rooms</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stats-box">
                    <i class="fa fa-building fa-2x mb-3"></i>
                    <h2 class="fw-bold mb-1">@ViewBag.TotalHotels</h2>
                    <p class="text-muted mb-0">Partner Hotels</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stats-box">
                    <i class="fa fa-users fa-2x mb-3"></i>
                    <h2 class="fw-bold mb-1">@ViewBag.TotalUsers</h2>
                    <p class="text-muted mb-0">Happy Clients</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stats-box">
                    <i class="fa fa-star fa-2x mb-3"></i>
                    <h2 class="fw-bold mb-1">4.9</h2>
                    <p class="text-muted mb-0">Avg. Rating</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Rooms Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="section-title text-primary text-uppercase fw-bold">Our Rooms</h6>
            <h1 class="display-5 fw-bold">Explore Our <span class="text-primary">Rooms</span></h1>
            <p class="text-muted mt-3" style="max-width:600px; margin:auto;">Experience comfort and elegance in every room we offer.</p>
        </div>
        <div class="row g-4">
            @if (ViewBag.TopRooms != null && ViewBag.TopRooms.Count > 0)
            {
                @foreach (var room in (List<Room>)ViewBag.TopRooms)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="room-card shadow-sm h-100">
                            <div class="position-relative overflow-hidden">
                                @if (room.RoomImages != null && room.RoomImages.Count > 0)
                                {
                                    <img src="@room.RoomImages.FirstOrDefault()?.ImageUrl" class="card-img-top" style="height:250px; object-fit:cover;" alt="Room">
                                }
                                else
                                {
                                    <img src="/images/default-room.jpg" class="card-img-top" style="height:250px; object-fit:cover;" alt="Room">
                                }
                                <span class="position-absolute top-0 end-0 price-badge m-3">$@room.PricePerNight<small>/night</small></span>
                            </div>
                            <div class="p-4">
                                <h5 class="fw-bold mb-2">@room.Type</h5>
                                <div class="d-flex gap-3 mb-3 text-muted small">
                                    <span><i class="bi bi-bed me-1"></i>@room.NumberOfBeds Beds</span>
                                    <span><i class="bi bi-wifi me-1"></i>Free WiFi</span>
                                </div>
                                <p class="text-muted small mb-3" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@room.Description</p>
                                <div class="d-flex gap-2">
                                    <a href="/Room/Detail/@room.Id" class="btn btn-primary btn-sm rounded-pill px-3 flex-grow-1">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a href="@Url.Action("AddToCart", "Cart", new { roomId = room.Id, checkIn = DateTime.Now, checkOut = DateTime.Now.AddDays(1) })" class="btn btn-accent btn-sm rounded-pill px-3">
                                        <i class="bi bi-cart-plus"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-house-door display-1 text-muted"></i>
                    <p class="text-muted mt-3">No rooms available at the moment.</p>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-controller="Room" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">
                View All Rooms <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Hotels Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="section-title text-primary text-uppercase fw-bold">Top Rated</h6>
            <h1 class="display-5 fw-bold">Explore Our <span class="text-primary">Top Hotels</span></h1>
            <p class="text-muted mt-3" style="max-width:600px; margin:auto;">Handpicked hotels with exceptional service and ratings.</p>
        </div>
        <div class="row g-4">
            @if (ViewBag.TopRatedHotels != null)
            {
                @foreach (var hotel in ViewBag.TopRatedHotels)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="hotel-card shadow-sm h-100">
                            <div class="position-relative overflow-hidden">
                                <img src="@hotel.ImageUrl" class="card-img-top" style="height:250px; object-fit:cover;" alt="@hotel.Name">
                                <div class="position-absolute bottom-0 start-0 end-0 p-3" style="background: linear-gradient(transparent, rgba(0,0,0,0.8));">
                                    <div class="star-rating mb-1">
                                        @for (int i = 0; i < hotel.Rating; i++)
                                        {
                                            <i class="fa fa-star"></i>
                                        }
                                        @for (int i = hotel.Rating; i < 5; i++)
                                        {
                                            <i class="far fa-star"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="p-4">
                                <h5 class="fw-bold mb-2">@hotel.Name</h5>
                                <p class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i>@hotel.City, @hotel.Location</p>
                                <p class="text-muted small mb-3" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@hotel.Description</p>
                                <div class="d-grid">
                                    <a class="btn btn-primary rounded-pill" asp-action="Index" asp-controller="Room" asp-route-hotelId="@hotel.Id">
                                        <i class="bi bi-door-open me-1"></i>View Rooms
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="py-5" style="background: linear-gradient(135deg, #0f4c81 0%, #0a3560 100%);">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-uppercase fw-bold" style="color: #d4a843; letter-spacing:2px;">Testimonials</h6>
            <h1 class="display-5 fw-bold text-white">What Our <span style="color: #d4a843;">Guests</span> Say</h1>
        </div>
        @if (ViewBag.Reviews != null)
        {
            <div class="row g-4">
                @foreach (var review in ViewBag.Reviews)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="testimonial-card h-100">
                            <div class="mb-3">
                                <i class="fa fa-quote-left fa-2x" style="color: #d4a843;"></i>
                            </div>
                            <p class="text-white-50 mb-4" style="line-height:1.8;">@review.Comment</p>
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
                                    <span class="text-white fw-bold">@review.UserName[0]</span>
                                </div>
                                <div class="ms-3">
                                    <h6 class="text-white mb-0 fw-bold">@review.UserName</h6>
                                    <small class="text-white-50">@review.HotelName</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- CTA Section -->
<section class="py-5">
    <div class="container">
        <div class="bg-primary rounded-4 p-5 text-center position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('/images/carousel-1.jpg') center/cover; opacity: 0.15;"></div>
            <div class="position-relative">
                <h2 class="text-white fw-bold mb-3">Ready for Your Next Stay?</h2>
                <p class="text-white-50 mb-4" style="max-width:500px; margin:auto;">Book now and enjoy exclusive deals and discounts on your favorite hotels.</p>
                <a href="@Url.Action("Index", "Room")" class="btn btn-gold btn-lg rounded-pill px-5 py-3">
                    <i class="bi bi-calendar-check me-2"></i>Book Your Stay
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('.owl-carousel').length) {
                $('.owl-carousel').owlCarousel({
                    loop: true,
                    margin: 30,
                    nav: false,
                    dots: true,
                    autoplay: true,
                    autoplayTimeout: 5000,
                    responsive: {
                        0: { items: 1 },
                        768: { items: 2 },
                        1024: { items: 3 }
                    }
                });
            }
        });
    </script>
}
