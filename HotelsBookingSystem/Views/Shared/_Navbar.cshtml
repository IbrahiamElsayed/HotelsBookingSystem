@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top shadow-lg" style="z-index: 1050;">
    <div class="container">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-4">
            <i class="bi bi-building me-2"></i>Hotelier
        </a>

        <button type="button" class="navbar-toggler border-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
            <div class="navbar-nav mx-auto">
                <a asp-controller="Home" asp-action="Index" class="nav-link px-3 @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-house-door me-1"></i>Home
                </a>
                <a asp-controller="Hotel" asp-action="Index" class="nav-link px-3 @(currentController == "Hotel" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-building me-1"></i>Hotels
                </a>
                <a asp-controller="Room" asp-action="Index" class="nav-link px-3 @(currentController == "Room" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-door-open me-1"></i>Rooms
                </a>
                <a asp-controller="About" asp-action="Index" class="nav-link px-3 @(currentController == "About" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-info-circle me-1"></i>About
                </a>
                <a asp-controller="Reviews" asp-action="Index" class="nav-link px-3 @(currentController == "Reviews" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-chat-quote me-1"></i>Reviews
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Cart" asp-action="Index" class="text-white text-decoration-none position-relative">
                    <i class="bi bi-cart3 fs-5"></i>
                    @await Component.InvokeAsync("CartSummary")
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <span class="text-white-50 d-none d-lg-block">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                    </span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Login
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-accent btn-sm rounded-pill px-3">
                        Register
                    </a>
                }
            </div>
        </div>
    </div>
</nav>
