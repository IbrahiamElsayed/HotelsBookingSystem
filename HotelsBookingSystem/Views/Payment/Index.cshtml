@{
    ViewData["Title"] = "Payment";
    Layout = "_Layout";
}

<style>
    .payment-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,0.1);
    }
    .payment-header {
        background: linear-gradient(135deg, #0f4c81 0%, #0a3560 100%);
        padding: 40px;
        text-align: center;
    }
    .payment-body { padding: 40px; }
    .summary-item {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 10px;
    }
    #card-element {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 15px;
        transition: border-color 0.3s;
    }
    #card-element:focus-within { border-color: #0f4c81; }
    .btn-pay {
        background: linear-gradient(135deg, #d4a843, #c9952e);
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-pay:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(212,168,67,0.4);
        color: #fff;
    }
</style>

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 80px);">
    <div class="payment-card w-100" style="max-width: 550px;">
        <div class="payment-header">
            <i class="bi bi-shield-check text-white fs-1 mb-3 d-block"></i>
            <h2 class="text-white fw-bold mb-2">Secure Payment</h2>
            <p class="text-white-50 mb-0">Complete your booking safely</p>
        </div>
        <div class="payment-body">
            <h5 class="fw-bold mb-3" style="color:#0f4c81;"><i class="bi bi-receipt me-2"></i>Booking Summary</h5>
            <div class="summary-item d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="bi bi-moon me-2"></i>Number of Nights</span>
                <span class="fw-bold fs-5">@ViewBag.TotalNights</span>
            </div>
            <div class="summary-item d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="bi bi-currency-dollar me-2"></i>Total Amount</span>
                <span class="fw-bold fs-4" style="color:#0f4c81;">$@ViewBag.TotalAmount</span>
            </div>

            <hr class="my-4">

            <form id="payment-form">
                <div class="mb-4">
                    <label class="form-label fw-bold"><i class="bi bi-credit-card me-2"></i>Credit or Debit Card</label>
                    <div id="card-element"></div>
                    <div id="card-errors" class="text-danger mt-2 small" role="alert"></div>
                </div>

                <button type="button" class="btn btn-pay text-white w-100 py-3 mb-3" id="payButton">
                    <i class="bi bi-lock me-2"></i>Confirm Payment - $@ViewBag.TotalAmount
                </button>
                <button type="reset" class="btn btn-outline-secondary w-100 rounded-pill">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>Reset
                </button>
            </form>

            <div class="text-center mt-4">
                <small class="text-muted">
                    <i class="bi bi-shield-lock me-1"></i>Your payment is secured with Stripe encryption
                </small>
            </div>
        </div>
    </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe('@(Context.RequestServices.GetRequiredService<IConfiguration>()["Stripe:PublishableKey"])');

    const elements = stripe.elements();
    const card = elements.create('card');
    card.mount('#card-element');

    card.addEventListener('change', function (event) {
        const displayError = document.getElementById('card-errors');
        displayError.textContent = event.error ? event.error.message : '';
    });

    document.getElementById('payButton').addEventListener('click', async () => {
        const response = await fetch('/Payment/CreatePayment', { method: 'POST' });
        const paymentData = await response.json();

        const result = await stripe.confirmCardPayment(paymentData.clientSecret, {
            payment_method: { card: card }
        });

        if (result.error) {
            alert(result.error.message);
        } else if (result.paymentIntent.status === 'succeeded') {
            window.location.href = '/Payment/Success';
        }
    });
</script>
